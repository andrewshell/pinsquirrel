{
  "name": "pinsquirrel",
  "version": "3.2.1",
  "description": "A pnpm monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm --filter @pinsquirrel/hono dev",
    "admin": "pnpm --filter @pinsquirrel/admin dev",
    "start": "pnpm --filter @pinsquirrel/hono start",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "turbo format",
    "test": "turbo test",
    "audit": "pnpm audit --prod --audit-level=high",
    "quality": "turbo typecheck && turbo lint && turbo test && turbo format && pnpm run audit",
    "db:up": "docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.dev.yml up -d mysql",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @pinsquirrel/database db:generate",
    "db:migrate": "pnpm --filter @pinsquirrel/database db:migrate",
    "docker:build-push": "./scripts/docker-build-push.sh",
    "docker:build-push-skip-quality": "./scripts/docker-build-push.sh --skip-quality",
    "docker:dry-run": "./scripts/docker-build-push.sh --dry-run --skip-quality",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "turbo": "latest",
    "typescript": "^6.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.18.1+sha512.77a884a165cbba2d8d1c19e3b4880eee6d2fcabd0d879121e282196b80042351d5eb3ca0935fa599da1dc51265cc68816ad2bddd2a2de5ea9fdf92adbec7cd34",
  "dependencies": {
    "tsx": "^4.23.1"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.18.0",
      "undici": ">=8.9.0",
      "form-data": ">=4.0.6",
      "fast-uri": ">=4.1.2",
      "qs": ">=6.15.2",
      "ip-address": ">=10.3.1",
      "@hono/node-server": ">=2.0.5",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "body-parser": ">=2.3.0",
      "shell-quote": ">=1.9.0",
      "brace-expansion": ">=5.0.9",
      "postcss": ">=8.5.23",
      "happy-dom": ">=20.8.9",
      "tsup>esbuild": "^0.28.1",
      "bundle-require>esbuild": "^0.28.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@hono/mcp>hono-rate-limiter": "0.4.2"
      }
    }
  },
  "lint-staged": {
    "apps/hono/src/**/*.{ts,tsx}": "pnpm --filter @pinsquirrel/hono eslint --fix",
    "apps/admin/src/**/*.{ts,tsx}": "pnpm --filter @pinsquirrel/admin eslint --fix",
    "libs/services/**/*.{ts,tsx,js,jsx}": "pnpm --filter @pinsquirrel/services eslint --fix",
    "libs/database/**/*.{ts,tsx,js,jsx}": "pnpm --filter @pinsquirrel/database eslint --fix",
    "libs/domain/**/*.{ts,tsx,js,jsx}": "pnpm --filter @pinsquirrel/domain eslint --fix",
    "libs/crypto/**/*.{ts,tsx}": "pnpm --filter @pinsquirrel/crypto eslint --fix",
    "libs/adapters/**/*.{ts,tsx,js,jsx}": "pnpm --filter @pinsquirrel/adapters eslint --fix",
    "libs/mailgun/**/*.{ts,tsx,js,jsx}": "pnpm --filter @pinsquirrel/mailgun eslint --fix",
    "**/*.{ts,tsx,js,jsx,json,md,css}": "prettier --write"
  }
}
