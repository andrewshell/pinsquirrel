{
  "name": "@pinsquirrel/ui",
  "version": "3.10.0",
  "description": "Shared Neo Brutalism UI primitives and design tokens for PinSquirrel",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest --watch --coverage",
    "test:coverage": "vitest --run --coverage --passWithNoTests"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
