{
  "name": "@pinsquirrel/adapters",
  "version": "1.0.0",
  "description": "Infrastructure adapters for external services and libraries",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest --run",
    "test:watch": "vitest --watch --coverage",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "@pinsquirrel/domain": "workspace:*",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
