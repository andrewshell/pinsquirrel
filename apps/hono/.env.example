# Environment Configuration
# Copy this file to .env and set your values

# Server Port (default: 8100)
PORT=8100

# Database URL - used by Drizzle ORM
# For local development (connecting to containerized DB):
DATABASE_URL=mysql://pinsquirrel:pinsquirrel@localhost:3306/pinsquirrel

# For Docker deployment (internal service communication):
# DATABASE_URL=mysql://pinsquirrel:pinsquirrel@mysql:3306/pinsquirrel

# For managed MySQL databases:
# DATABASE_URL=mysql://username:password@hostname:3306/database

# Application Environment
NODE_ENV=development

# Public origin of this deployment. Used as the OAuth issuer and as the origin
# of the /mcp and /api/v1 resource identifiers, so it must be the URL clients
# actually reach - it is never derived from the request, or a spoofed Host
# header would change what the server claims to be.
# Required when NODE_ENV=production (boot fails without it); defaults to
# http://localhost:8100 otherwise.
BASE_URL=http://localhost:8100

# Reverse proxy (optional). Set to any non-empty value when a proxy such as
# Caddy sits in front of the app and sets x-forwarded-for; the IP rate limiters
# then key on the address it reports. Leave unset for direct access - a caller
# that can write the header itself would otherwise get a fresh limit budget per
# request.
# TRUST_PROXY=1

# Mailgun Configuration (for password reset emails)
# Leave empty to disable password reset functionality
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=PinSquirrel

# Signup Notification Email (optional)
NOTIFY_EMAIL=

# Email sealing public key (optional). When set, signup emails are sealed to
# this key so the waitlist can be contacted via the offline admin app. This
# server can NEVER decrypt them. Generate with:
#   pnpm --filter @pinsquirrel/crypto keygen
EMAIL_PUBLIC_KEY=
