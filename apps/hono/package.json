{
  "name": "@pinsquirrel/hono",
  "private": true,
  "version": "3.6.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"tsx watch src/index.ts\" \"pnpm css:watch\"",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest --watch --coverage",
    "test:coverage": "vitest --run --coverage",
    "css:build": "tailwindcss -i ./src/styles/app.css -o ./src/static/styles.css",
    "css:watch": "tailwindcss -i ./src/styles/app.css -o ./src/static/styles.css --watch"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pinsquirrel/adapters": "workspace:*",
    "@pinsquirrel/crypto": "workspace:*",
    "@pinsquirrel/database": "workspace:*",
    "@pinsquirrel/domain": "workspace:*",
    "@pinsquirrel/mailgun": "workspace:*",
    "@pinsquirrel/services": "workspace:*",
    "@pinsquirrel/ui": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.16",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "hono": "^4.13.3",
    "mailgun.js": "^14.0.0",
    "mysql2": "^3.23.4",
    "pino": "^10.3.1",
    "turndown": "^7.2.4",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
