{
  "name": "@pinsquirrel/hono",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"tsx watch src/index.ts\" \"pnpm css:watch\"",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest --watch --coverage",
    "test:coverage": "vitest --run --coverage",
    "css:build": "tailwindcss -i ./src/styles/app.css -o ./src/static/styles.css",
    "css:watch": "tailwindcss -i ./src/styles/app.css -o ./src/static/styles.css --watch",
    "grant-access": "tsx src/scripts/grant-access.ts",
    "grant-admin": "tsx src/scripts/grant-admin.ts"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.1",
    "@hono/node-server": "^2.0.11",
    "@hono/zod-openapi": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pinsquirrel/adapters": "workspace:*",
    "@pinsquirrel/crypto": "workspace:*",
    "@pinsquirrel/database": "workspace:*",
    "@pinsquirrel/domain": "workspace:*",
    "@pinsquirrel/mailgun": "workspace:*",
    "@pinsquirrel/services": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.11",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "mailgun.js": "^13.3.0",
    "pino": "^10.3.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.12.2",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
