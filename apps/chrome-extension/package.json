{
  "name": "@pinsquirrel/chrome-extension",
  "private": true,
  "version": "1.2.2",
  "description": "Chrome extension that syncs PinSquirrel bookmarks over the v1 REST API",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "package": "NODE_ENV=production node scripts/build.ts && node scripts/package.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint \"{src,scripts}/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest --watch --coverage",
    "test:coverage": "vitest --run --coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
