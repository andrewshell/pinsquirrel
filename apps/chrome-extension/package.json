{
  "name": "@pinsquirrel/chrome-extension",
  "private": true,
  "version": "3.6.0",
  "description": "Chrome extension that syncs PinSquirrel bookmarks over the v1 REST API",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint \"{src,scripts}/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest --watch --coverage",
    "test:coverage": "vitest --run --coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
