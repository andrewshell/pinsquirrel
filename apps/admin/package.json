{
  "name": "@pinsquirrel/admin",
  "private": true,
  "version": "3.10.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"tsx watch src/index.ts\" \"pnpm css:watch\"",
    "start": "pnpm css:build && tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest --watch --coverage",
    "test:coverage": "vitest --run --coverage",
    "css:build": "tailwindcss -i ./src/styles/app.css -o ./src/static/styles.css",
    "css:watch": "tailwindcss -i ./src/styles/app.css -o ./src/static/styles.css --watch"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@pinsquirrel/crypto": "workspace:*",
    "@pinsquirrel/database": "workspace:*",
    "@pinsquirrel/domain": "workspace:*",
    "@pinsquirrel/mailgun": "workspace:*",
    "@pinsquirrel/services": "workspace:*",
    "@pinsquirrel/ui": "workspace:*",
    "dotenv": "^18.0.9",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
