{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "extra-files": [
        {
          "type": "json",
          "path": "apps/admin/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/chrome-extension/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/chrome-extension/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/hono/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "libs/adapters/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "libs/crypto/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "libs/database/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "libs/domain/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "libs/mailgun/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "libs/services/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Styles",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous Chores",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "Code Refactoring",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    }
  ]
}
